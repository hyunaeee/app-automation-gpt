# Optional shared API key. Users can instead connect their own key in Settings.
# No personal or shared key = clearly labeled local templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional role overrides. Empty = choose from this API account's available models.
OPENAI_PLANNER_MODEL=
OPENAI_CODER_MODEL=
OPENAI_DEBUGGER_MODEL=
OPENAI_IMAGE_MODEL=
# OpenAI only. Local subscription runner: AI_PROVIDER=codex (requires codex login).
# Vercel supports AI_PROVIDER=openai; local subscription credentials stay on this computer.
AI_PROVIDER=openai
CODEX_CLI_PATH=
CODEX_MODEL=
PORT=3001
# Local API is loopback-only by default. Keep this for local development.
HOST=127.0.0.1

# Vercel deployment (private Blob storage + isolated Sandbox execution)
# Set these in the Vercel project's Environment Variables, never VITE_*.
BLOB_READ_WRITE_TOKEN=
WORKSPACE_PASSWORD=
SESSION_SECRET=
# Google identity (not Google AI subscription quota). Exact origin, no path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_APP_URL=http://127.0.0.1:3001
# Optional comma-separated Google account allowlist.
GOOGLE_ALLOWED_EMAILS=
# APK: use installed local SDK, or an authenticated SDK host for Vercel.
ANDROID_BUILDER_URL=
ANDROID_BUILDER_TOKEN=
# Exact provider/model token rates, USD per million. No default prices.
ESTIMATE_MODEL_RATES_JSON=
# Sandbox authentication is automatic on Vercel via OIDC.
